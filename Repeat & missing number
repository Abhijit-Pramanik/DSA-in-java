class Solution {
    public int[] findMissingAndRepeatedValues(int[][] grid) {
        
        int n = grid.length;
        HashSet<Integer> set = new HashSet<>();
        
        int repeated = 0;
        long actualSum = 0;
        
        // Traverse grid
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                
                int value = grid[i][j];
                actualSum += value;
                
                // If already exists → repeated
                if (set.contains(value)) {
                    repeated = value;
                }
                
                set.add(value);
            }
        }
        
        // Expected sum from 1 to n*n
        long total = (long) n * n;
        long expectedSum = total * (total + 1) / 2;
        
        // Missing number
        int missing = (int)(expectedSum + repeated - actualSum);
        
        return new int[]{repeated, missing};
    }
}
